# Enable URL Rewriting
RewriteEngine On
RewriteBase /Sk_online_it_solutions/in_php/

# Blog routes and sitemap
RewriteRule ^blog/?$ blog.php [L,QSA]
RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog_details.php?slug=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

# Remove .php extension from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# Redirect from .php to clean URL
RewriteCond %{THE_REQUEST} ^GET\ (.*)\.php\ HTTP
RewriteRule ^(.*)\.php$ $1 [R=301,L]

# Remove trailing slash if not a directory
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Custom error pages (optional)
ErrorDocument 404 /Sk_online_it_solutions/in_php/index.php

# Disable directory browsing
Options -Indexes

# Set default character encoding
AddDefaultCharset UTF-8
